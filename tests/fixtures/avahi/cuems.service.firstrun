<service-group>
  <name replace-wildcards="yes">%h</name>
  <service protocol="ipv4">
    <type>_cuems_nodeconf._tcp</type>
    <port>9000</port>
    <txt-record>node_role=firstrun</txt-record>
    <txt-record>uuid=00000000-0000-0000-0000-000000000000</txt-record>
  </service>

  <service protocol="ipv4">
    <type>_cuems_osc._tcp</type>
    <port>9090</port>
    <txt-record>node_role=firstrun</txt-record>
    <txt-record>uuid=00000000-0000-0000-0000-000000000000</txt-record>
  </service>
</service-group>